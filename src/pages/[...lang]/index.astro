---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import WorldMap from '../../components/WorldMap.astro';
import SiteName from '../../components/SiteName.astro';
import { SITE_TITLE } from '../../consts';
import { langOf, localize, t } from '../../i18n';
import { LANGS, MAP_SIZE, newestFirst } from '../../posts';

export const getStaticPaths = () => LANGS.map(({ param }) => ({ params: { lang: param } }));

const lang = langOf(Astro.url);
const allPosts = await newestFirst(lang);
const posts = allPosts.slice(0, MAP_SIZE);
// Ticker: everything from the 24 hours before the newest post, so it is never empty between builds
const since = allPosts[0]?.data.pubDate.valueOf() - 24 * 60 * 60 * 1000;
const today = allPosts.filter((p) => p.data.pubDate.valueOf() >= since);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={t(lang).description} />
	</head>
	<body>
		<Header />
		<main>
			{
				today.length > 0 && (
					<div class="ticker">
						<span class="label">{t(lang).today}</span>
						<div class="track">
							<div class="belt">
								{[0, 1].map((copy) => (
									<ul aria-hidden={copy ? 'true' : undefined}>
										{today.map((p) => (
											<li>
												<a href={localize(lang, `/blog/${p.id}/`)} tabindex={copy ? -1 : undefined}>
													{p.data.title}
												</a>
											</li>
										))}
									</ul>
								))}
							</div>
						</div>
					</div>
				)
			}
			<h1><SiteName /></h1>
			<p>{t(lang).description}</p>
			<WorldMap posts={posts} />
			<h2>{t(lang).latest}</h2>
			<PostList posts={posts} />
			<p><a href={localize(lang, '/blog/')}>{t(lang).seeAll}</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.ticker {
		display: flex;
		align-items: stretch;
		margin-bottom: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		overflow: hidden;
		font-size: 0.9rem;
	}
	.label {
		flex-shrink: 0;
		padding: 0.5em 0.9em;
		background: var(--accent);
		color: var(--bg);
		font-weight: 700;
		white-space: nowrap;
	}
	.track {
		min-width: 0;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 2em, #000 calc(100% - 2em), transparent);
	}
	.belt {
		display: flex;
		width: max-content;
		animation: ticker 40s linear infinite;
	}
	.ticker:hover .belt,
	.ticker:focus-within .belt {
		animation-play-state: paused;
	}
	.belt ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.belt li {
		padding: 0.5em 1.5em;
		white-space: nowrap;
	}
	.belt li::before {
		content: '●';
		margin-right: 0.6em;
		color: var(--accent);
		font-size: 0.6em;
		vertical-align: middle;
	}
	.belt a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.belt a:hover {
		color: var(--accent);
	}
	@keyframes ticker {
		to {
			transform: translateX(-50%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.belt {
			animation: none;
		}
		.track {
			overflow-x: auto;
		}
	}
</style>
