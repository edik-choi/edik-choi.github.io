---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { firstImage, isTrusted, newestFirst, sourceCount } from '../../posts';

export async function getStaticPaths() {
	const posts = await newestFirst();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { ...post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}
type Props = CollectionEntry<'blog'> & { newer?: CollectionEntry<'blog'>; older?: CollectionEntry<'blog'> };

const post = Astro.props;
const { Content } = await render(post);
const sources = sourceCount(post.body);
---

<BlogPost {...post.data} sources={sources} trusted={isTrusted(post)} newer={post.newer} older={post.older} ogImage={firstImage(post.body)?.endsWith('.svg') ? `/og/${post.id}.png` : undefined}>
	<Content />
</BlogPost>
