---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { firstImage, isTrusted, sourceCount } from '../../posts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const sources = sourceCount(post.body);
---

<BlogPost {...post.data} sources={sources} trusted={isTrusted(post)} ogImage={firstImage(post.body)?.endsWith('.svg') ? `/og/${post.id}.png` : undefined}>
	<Content />
</BlogPost>
