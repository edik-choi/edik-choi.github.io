---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { MAP_SIZE, newestFirst } from '../posts';
import { langOf, twinPath } from '../i18n';

interface Props {
	title: string;
	description: string;
	// Link-preview image path (1200x630 PNG); posts pass /og/<slug>.png
	image?: string;
	imageAlt?: string;
	published?: Date;
	// false when the page has no version in the other language (an untranslated post)
	translated?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const latestIds = (await newestFirst()).slice(0, MAP_SIZE).map((p) => p.id);

const { title, description, image = '/og.png', imageAlt = SITE_TITLE, published, translated = true } = Astro.props;
const lang = langOf(Astro.url);
const twinURL = new URL(twinPath(Astro.url.pathname), Astro.site);
// hreflang: tells search engines which URL to show readers of each language
const alternates = translated ? { [lang]: canonicalURL, [lang === 'ko' ? 'en' : 'ko']: twinURL } : { [lang]: canonicalURL };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
	let t;
	try {
		t = localStorage.getItem('theme');
	} catch {}
	document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
</script>
<script is:inline define:vars={{ latestIds }}>
	// Space mode: every story on the home map is stamped in the passport (PassportStamp.astro).
	// A new story pulls the reader back to Earth; wwhReentry is how many are waiting on that first visit back.
	const unreadCount = () => {
		let book = {};
		try {
			book = JSON.parse(localStorage.getItem('wwh-passport') || '{}');
		} catch {}
		return latestIds.filter((id) => !book[id]).length;
	};
	window.wwhAllRead = () => !unreadCount();
	window.wwhWorld = () => {
		let was;
		try {
			was = localStorage.getItem('wwh-world');
		} catch {}
		const unread = unreadCount();
		const world = unread ? 'earth' : 'space';
		document.documentElement.dataset.world = world;
		try {
			localStorage.setItem('wwh-world', world);
		} catch {}
		return was === 'space' ? unread : 0;
	};
	window.wwhReentry = window.wwhWorld();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(lang === 'ko' ? 'ko/rss.xml' : 'rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-body" preload />
{lang === 'ko' && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" crossorigin />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

{Object.entries(alternates).map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}
{alternates.en && <link rel="alternate" hreflang="x-default" href={alternates.en} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Link previews (Open Graph, X/Twitter) -->
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={published ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
{translated && <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{published && (
	<script
		type="application/ld+json"
		set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'NewsArticle',
			headline: title,
			description,
			image: [new URL(image, Astro.site).href],
			datePublished: published.toISOString(),
			mainEntityOfPage: canonicalURL.href,
			author: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
			publisher: { '@type': 'Organization', name: SITE_TITLE, url: Astro.site?.href },
		})}
	/>
)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- GoatCounter analytics -->
<script is:inline data-goatcounter="https://worldwidehype.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

<meta name="google-site-verification" content="RjWNlqPFWkHt_wCW-o_kKZOev2M3yL4-PilthFxidW4" />
<meta name="naver-site-verification" content="b2e0e16e480409a04778b06298e0ef28044bca82" />

<!-- Google AdSense -->
<meta name="google-adsense-account" content="ca-pub-2222587566046092" />
<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2222587566046092" crossorigin="anonymous"></script>
