---
// Space mode only: stars stream out as if seen from a moving ship. Full booster at the top of the page,
// easing to cruise as the reader scrolls down. On the home page they stream out from behind the globe and move with it.
---

<script>
	const root = document.documentElement;
	const canvas = document.createElement('canvas');
	canvas.className = 'warp';
	canvas.setAttribute('aria-hidden', 'true');
	document.body.prepend(canvas);
	const ctx = canvas.getContext('2d')!;
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const rand = () => Math.random() * 2 - 1;
	// x, y: direction from the centre; z: distance (1 far, 0 at the viewer)
	const stars = Array.from({ length: 450 }, () => ({ x: rand(), y: rand(), z: Math.random() }));
	let w = 0, h = 0, speed = 0, last = 0, running = false;
	const globe = document.querySelector('.globe');
	// All posts list (/blog/, its pages and categories): faint stars, like behind a post
	if (/^(\/ko)?\/blog/.test(location.pathname) && !document.querySelector('article')) canvas.classList.add('faint');

	const resize = () => {
		const d = devicePixelRatio || 1;
		w = innerWidth;
		h = innerHeight;
		canvas.width = w * d;
		canvas.height = h * d;
		ctx.setTransform(d, 0, 0, d, 0, 0);
	};
	const frame = (t: number) => {
		if (root.dataset.world !== 'space') {
			running = false;
			return;
		}
		const dt = Math.min((t - last) / 1000, 0.05);
		last = t;
		// Booster fades out over the first screen of scrolling; ease toward it so it never jumps
		const boost = Math.max(0, 1 - scrollY / h);
		speed += ((still ? 0 : 0.1 + boost) - speed) * Math.min(dt * 1.5, 1);
		// Vanishing point: the globe's centre on the home page (scrolls with it), else the screen centre.
		// Once the globe scrolls past the upper third it stays there, so stars keep passing after the globe is gone.
		const g = globe?.getBoundingClientRect();
		const cx = g ? g.left + g.width / 2 : w / 2, cy = g ? Math.max(g.top + g.height / 2, h * 0.3) : h / 2, f = Math.max(w, h) * 0.5;
		ctx.clearRect(0, 0, w, h);
		ctx.strokeStyle = '#fff';
		ctx.lineCap = 'round';
		for (const s of stars) {
			s.z -= speed * dt * 0.5;
			const sx = cx + (s.x / s.z) * f, sy = cy + (s.y / s.z) * f;
			if (s.z <= 0.02 || sx < 0 || sx > w || sy < 0 || sy > h) {
				Object.assign(s, { x: rand(), y: rand(), z: 1 });
				continue;
			}
			// Tail: where the star was a moment ago, so streaks stretch with speed
			const tz = s.z + speed * 0.06;
			ctx.globalAlpha = Math.min(1, (1 - s.z) * 1.4);
			ctx.lineWidth = 0.6 + (1 - s.z) * 2;
			ctx.beginPath();
			ctx.moveTo(cx + (s.x / tz) * f, cy + (s.y / tz) * f);
			ctx.lineTo(sx + 0.1, sy);
			ctx.stroke();
		}
		requestAnimationFrame(frame);
	};
	const start = () => {
		if (running || root.dataset.world !== 'space') return;
		running = true;
		last = performance.now();
		requestAnimationFrame(frame);
	};
	addEventListener('wwh-launch', () => (speed = 3)); // lift-off (PassportStamp.astro): a burst that eases back to cruise
	// Carry the speed across page loads, so the lift-off burst keeps going on the home page it lands on
	addEventListener('pagehide', () => {
		try {
			sessionStorage.setItem('wwh-warp', String(speed));
		} catch {}
	});
	try {
		speed = +(sessionStorage.getItem('wwh-warp') || 0);
		sessionStorage.removeItem('wwh-warp');
	} catch {}
	addEventListener('resize', resize);
	resize();
	start();
	// The last passport stamp switches to space mid-page
	new MutationObserver(start).observe(root, { attributes: true, attributeFilter: ['data-world'] });
</script>

<style>
	:global(canvas.warp) {
		position: fixed;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	/* Fainter behind a post so the text stays easy to read */
	:global(body:has(article) canvas.warp),
	:global(canvas.warp.faint) {
		opacity: 0.35;
	}
	:global(:root:not([data-world='space']) canvas.warp) {
		display: none;
	}
</style>
