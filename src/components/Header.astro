---
import SiteName from './SiteName.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Warp from './Warp.astro';
import { langOf, localize, t, twinPath } from '../i18n';

interface Props {
	// false on a post with no translation: the language link goes to the other language's home page instead
	translated?: boolean;
}
const { translated = true } = Astro.props;
const lang = langOf(Astro.url);
const ui = t(lang);
const twin = translated ? twinPath(Astro.url.pathname) : localize(lang === 'ko' ? 'en' : 'ko', '/');
---

<header>
	<nav>
		<h2>
			<a href={localize(lang, '/')}><SiteName /></a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={localize(lang, '/')}>{ui.home}</HeaderLink>
			<HeaderLink href={localize(lang, '/blog')}>{ui.allPosts}</HeaderLink>
			<HeaderLink href={localize(lang, '/about')}>{ui.about}</HeaderLink>
			<a class="lang" href={twin} hreflang={lang === 'ko' ? 'en' : 'ko'} lang={lang === 'ko' ? 'en' : 'ko'}>{ui.switchLang}</a>
			<ThemeToggle />
			<Warp />
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		overflow-x: clip;
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1280px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	/* Korean labels are short but would otherwise break between syllables */
	.lang,
	nav a:lang(ko) {
		white-space: nowrap;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.5em;
		}
		nav a {
			padding: 1em 0.35em;
			font-size: 0.85em;
		}
	}
</style>
