---
import { dateLocale, langOf } from '../i18n';

interface Props {
	date: Date;
}

const { date } = Astro.props;
const locale = dateLocale[langOf(Astro.url)];
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(locale, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	})}
</time>
