---
import type { Page } from 'astro';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PostList from './PostList.astro';
import { CATEGORIES, SITE_TITLE } from '../consts';
import { langOf, localize, t } from '../i18n';
import type { Post } from '../posts';

interface Props {
	page: Page<Post>;
	category?: string;
}

const { page, category } = Astro.props;
const lang = langOf(Astro.url);
const ui = t(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={ui.description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{ui.allPosts}</h1>
			<nav class="chips" aria-label={ui.categories}>
				<a href={localize(lang, '/blog/')} aria-current={!category ? 'page' : undefined}>{ui.all}</a>
				{
					CATEGORIES.map((c) => (
						<a href={localize(lang, `/blog/category/${c}/`)} aria-current={c === category ? 'page' : undefined}>
							{ui.category[c]}
						</a>
					))
				}
			</nav>
			{page.data.length ? <PostList posts={page.data} /> : <p>{ui.empty}</p>}
			{
				page.lastPage > 1 && (
					<nav class="pager">
						{page.url.prev ? <a href={page.url.prev}>{ui.newer}</a> : <span />}
						<span>
							{page.currentPage} / {page.lastPage}
						</span>
						{page.url.next ? <a href={page.url.next}>{ui.older}</a> : <span />}
					</nav>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.chips a {
		padding: 0.25em 0.9em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		text-decoration: none;
		text-transform: capitalize;
	}
	.chips a:hover {
		border-color: var(--accent);
	}
	.chips a[aria-current] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		margin-top: 2rem;
	}
	.pager > :last-child {
		justify-self: end;
	}
</style>
