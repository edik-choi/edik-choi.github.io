---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PostList from './PostList.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	page: Page<CollectionEntry<'blog'>>;
	category?: string;
}

const { page, category } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>All posts</h1>
			<nav class="chips" aria-label="Categories">
				<a href="/blog/" aria-current={!category ? 'page' : undefined}>All</a>
				{
					CATEGORIES.map((c) => (
						<a href={`/blog/category/${c}/`} aria-current={c === category ? 'page' : undefined}>
							{c}
						</a>
					))
				}
			</nav>
			{page.data.length ? <PostList posts={page.data} /> : <p>No posts in this category yet.</p>}
			{
				page.lastPage > 1 && (
					<nav class="pager">
						{page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span />}
						<span>
							{page.currentPage} / {page.lastPage}
						</span>
						{page.url.next ? <a href={page.url.next}>Older →</a> : <span />}
					</nav>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.chips a {
		padding: 0.25em 0.9em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		text-decoration: none;
		text-transform: capitalize;
	}
	.chips a:hover {
		border-color: var(--accent);
	}
	.chips a[aria-current] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		margin-top: 2rem;
	}
	.pager > :last-child {
		justify-self: end;
	}
</style>
