---
import { type Post, firstImage, isTrusted } from '../posts';
import { langOf, localize, t } from '../i18n';
import FormattedDate from './FormattedDate.astro';
import TrustBadge from './TrustBadge.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
const lang = langOf(Astro.url);
---

<ul class="post-list">
	{
		posts.map((post) => {
			const thumb = firstImage(post.body);
			return (
				<li data-post={post.id}>
					<a href={localize(lang, `/blog/${post.id}/`)}>
						<div class="text">
							{isTrusted(post) && <TrustBadge />}
							<h3 class="title">{post.data.title}</h3>
							<p class="desc">{post.data.description}</p>
							<p class="date">
								<FormattedDate date={post.data.pubDate} /> · <span class="cat">{t(lang).category[post.data.category]}</span>
							</p>
						</div>
						{thumb && <img src={thumb} alt="" loading="lazy" width="1200" height="675" />}
					</a>
				</li>
			);
		})
	}
</ul>

<script>
	// Stories stamped in the reader's passport (PassportStamp.astro) get a faded title; the Earth reset clears it
	let book: Record<string, unknown> = {};
	try {
		book = JSON.parse(localStorage.getItem('wwh-passport') || '{}');
	} catch {}
	document.querySelectorAll<HTMLElement>('li[data-post]').forEach((li) => li.classList.toggle('read', li.dataset.post! in book));
</script>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: inherit;
		text-decoration: none;
	}
	.text {
		min-width: 0;
	}
	.title {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
		line-height: 1.3;
		color: rgb(var(--black));
		/* Korean: break between words, not mid-word */
		word-break: keep-all;
	}
	.desc {
		margin: 0 0 0.25rem;
		font-size: 0.95rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		margin: 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}
	.cat {
		text-transform: capitalize;
	}
	img {
		flex-shrink: 0;
		width: 180px;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
	}
	/* Set by the world map when a dot with several stories is clicked */
	li.lit a {
		background: linear-gradient(90deg, var(--highlight), transparent 80%);
	}
	li.read .title {
		opacity: 0.5;
	}
	a:hover .title {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		img {
			width: 104px;
		}
		.title {
			font-size: 1.05rem;
		}
		.desc {
			display: none;
		}
	}
</style>
