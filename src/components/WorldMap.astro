---
import type { CollectionEntry } from 'astro:content';
import land from '../assets/world-land.txt?raw';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
// Equirectangular, same projection the land path was generated with (1000x500 = whole globe)
const x = (lon: number) => ((lon + 180) / 360) * 1000;
const y = (lat: number) => ((90 - lat) / 180) * 500;
// Posts closer than this (map units, ~9 degrees) share one dot. Posts come newest first, so the newest names the dot.
const NEAR = 25;
const pins: { x: number; y: number; name: string; posts: CollectionEntry<'blog'>[] }[] = [];
for (const post of posts) {
	const { name, lat, lon } = post.data.location ?? {};
	if (name === undefined) continue;
	const px = x(lon!), py = y(lat!);
	const pin = pins.find((p) => Math.hypot(p.x - px, p.y - py) < NEAR);
	if (pin) pin.posts.push(post);
	else pins.push({ x: px, y: py, name, posts: [post] });
}
---

<figure>
	<svg class="map" viewBox="0 17 1000 395" role="img" aria-label="Map of where recent stories happened">
		<path d={land} />
		{
			pins.map(({ x: cx, y: cy, name, posts: group }) => {
				const many = group.length > 1;
				const label = many ? `${name} · ${group.length} stories` : name;
				return (
					<a href={`/blog/${group[0].id}/`} data-posts={group.map((p) => p.id).join(' ')} aria-label={many ? `${label}: show them in the list` : `${group[0].data.title} (${name})`}>
						<title>{many ? `${label}\n${group.map((p) => p.data.title).join('\n')}` : `${name}: ${group[0].data.title}`}</title>
						<circle class="hit" cx={cx} cy={cy} r="22" />
						<circle class="ring" cx={cx} cy={cy} r="9" />
						<circle class="dot" cx={cx} cy={cy} r={many ? 13 : 9} />
						{many && <text class="count" x={cx} y={cy} dy="0.35em" text-anchor="middle">{group.length}</text>}
						<text class="name" x={cx} y={cy - 26} text-anchor="middle">{label}</text>
					</a>
				);
			})
		}
	</svg>
	<figcaption class="passport" hidden></figcaption>
</figure>
<button class="back" type="button" hidden>↑ Back to map</button>

<script>
	// Passport: pins with a story the reader finished get a stamp mark (see PassportStamp.astro)
	let book: Record<string, { place: string }> = {};
	try {
		book = JSON.parse(localStorage.getItem('wwh-passport') || '{}');
	} catch {}
	const read = Object.keys(book);
	const caption = document.querySelector<HTMLElement>('.passport')!;
	const reentry = (window as any).wwhReentry as number;
	if (reentry) {
		caption.textContent = `Re-entry complete: ${reentry} new ${reentry > 1 ? 'stories' : 'story'} on Earth`;
		caption.hidden = false;
	} else if (document.documentElement.dataset.world === 'space') {
		caption.textContent = 'All caught up. Welcome to Space Wide Hype';
		caption.hidden = false;
	}
	// Space mode: join the read stories' dots in reading order, like a constellation
	if (document.documentElement.dataset.world === 'space') {
		const pts: string[] = [];
		read.forEach((id) => {
			const dot = document.querySelector<SVGCircleElement>(`svg a[data-posts~="${id}"] .dot`);
			const pt = dot && `${dot.getAttribute('cx')},${dot.getAttribute('cy')}`;
			if (pt && pt !== pts.at(-1)) pts.push(pt);
		});
		if (pts.length > 1) {
			const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
			line.setAttribute('class', 'constellation');
			line.setAttribute('points', pts.join(' '));
			line.setAttribute('pathLength', '1');
			const svg = document.querySelector('svg.map')!;
			svg.insertBefore(line, svg.querySelector('a')); // under the dots
		}
	}
	if (read.length) {
		document.querySelectorAll<SVGAElement>('svg a[data-posts]').forEach((pin) => {
			if (pin.dataset.posts!.split(' ').some((id) => book[id])) pin.classList.add('read');
		});
		const places = new Set(read.map((id) => book[id].place)).size;
		if (caption.hidden) caption.textContent = `Your passport: ${read.length} ${read.length > 1 ? 'stamps' : 'stamp'} from ${places} ${places > 1 ? 'places' : 'place'}`;
		caption.hidden = false;
	}

	// Hovering a post in the list lights up its pin on the map
	const pins = document.querySelectorAll<SVGAElement>('svg a[data-posts]');
	const has = (pin: SVGAElement, id?: string) => !!id && pin.dataset.posts!.split(' ').includes(id);
	let current: string | undefined;
	const light = (e: Event) => {
		const id = (e.target as Element).closest<HTMLElement>('li[data-post]')?.dataset.post;
		if (id === current) return;
		current = id;
		pins.forEach((pin) => {
			pin.classList.toggle('active', has(pin, id));
			if (has(pin, id)) pin.parentNode!.appendChild(pin); // draw on top of overlapping pins
		});
	};
	document.addEventListener('mouseover', light);
	document.addEventListener('focusin', light);

	// A dot with several stories scrolls to the list and marks them there instead of opening one
	const items = [...document.querySelectorAll<HTMLElement>('li[data-post]')];
	const backBtn = document.querySelector<HTMLButtonElement>('button.back')!;
	pins.forEach((pin) => {
		const ids = pin.dataset.posts!.split(' ');
		if (ids.length < 2) return;
		pin.addEventListener('click', (e) => {
			e.preventDefault();
			items.forEach((li) => li.classList.toggle('lit', ids.includes(li.dataset.post!)));
			items.find((li) => ids.includes(li.dataset.post!))?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			backBtn.hidden = false;
		});
	});
	// Clears the marks and returns to the map
	backBtn.addEventListener('click', () => {
		items.forEach((li) => li.classList.remove('lit'));
		backBtn.hidden = true;
		document.querySelector('figure svg.map')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});
</script>

<style>
	figure {
		margin: 0 0 2em;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.map {
		fill: rgb(var(--gray-light));
	}
	.hit {
		fill: transparent;
	}
	.dot {
		fill: var(--accent);
		stroke: var(--bg);
		stroke-width: 3;
	}
	.ring {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		transform-box: fill-box;
		transform-origin: center;
		animation: ping 2.4s ease-out infinite;
	}
	.dot,
	.name {
		transform-box: fill-box;
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.6, 1), opacity 0.3s;
	}
	.dot {
		transform-origin: center;
	}
	.count {
		fill: var(--bg);
		font-size: 16px;
		font-weight: 700;
		pointer-events: none;
	}
	.name {
		transform-origin: bottom;
		fill: rgb(var(--black));
		font-size: 30px;
		font-weight: 700;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
	}
	a:hover .dot,
	a:focus-visible .dot,
	.active .dot {
		fill: var(--accent-dark);
		transform: scale(1.6);
	}
	a:hover .name,
	a:focus-visible .name,
	.active .name {
		opacity: 1;
		transform: none;
	}
	:global(.constellation) {
		fill: none;
		stroke: rgb(var(--black));
		stroke-width: 1.5;
		stroke-opacity: 0.55;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		animation: trace 3s ease-in-out forwards;
	}
	@keyframes trace {
		from { stroke-dashoffset: 1; }
		to { stroke-dashoffset: 0; }
	}
	/* In space the dots become stars */
	:global([data-world='space']) a .dot {
		fill: #fff8d8;
		filter: drop-shadow(0 0 6px #fff8d8);
	}
	:global([data-world='space']) a .ring {
		stroke: #fff8d8;
	}
	.read .dot {
		fill: var(--stamp);
	}
	.read .ring {
		stroke: var(--stamp);
	}
	.passport {
		margin-top: 0.5em;
		color: var(--stamp);
		font-family: Helvetica, Arial, sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
	}
	.active .ring {
		animation-duration: 1s;
	}
	.back {
		position: fixed;
		bottom: 1.5em;
		left: 50%;
		z-index: 10;
		transform: translateX(-50%);
		padding: 0.6em 1.2em;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: var(--bg);
		font: inherit;
		font-weight: 700;
		box-shadow: var(--box-shadow);
		cursor: pointer;
	}
	.back[hidden] {
		display: none;
	}
	@keyframes ping {
		from { transform: scale(1); opacity: 0.9; }
		to { transform: scale(3); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ring { animation: none; opacity: 0; }
		:global(.constellation) { animation: none; stroke-dasharray: none; }
	}
</style>
