---
import type { CollectionEntry } from 'astro:content';
import land from '../assets/world-land.txt?raw';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
// Equirectangular, same projection the land path was generated with (1000x500 = whole globe)
const x = (lon: number) => ((lon + 180) / 360) * 1000;
const y = (lat: number) => ((90 - lat) / 180) * 500;
// Posts closer than this (map units, ~9 degrees) share one dot. Posts come newest first, so the newest names the dot.
const NEAR = 25;
const pins: { x: number; y: number; name: string; posts: CollectionEntry<'blog'>[] }[] = [];
for (const post of posts) {
	const { name, lat, lon } = post.data.location ?? {};
	if (name === undefined) continue;
	const px = x(lon!), py = y(lat!);
	const pin = pins.find((p) => Math.hypot(p.x - px, p.y - py) < NEAR);
	if (pin) pin.posts.push(post);
	else pins.push({ x: px, y: py, name, posts: [post] });
}
---

<figure>
	<svg class="map" viewBox="0 17 1000 395" role="img" aria-label="Map of where recent stories happened">
		<g id="world">
		<path d={land} />
		{
			pins.map(({ x: cx, y: cy, name, posts: group }) => {
				const many = group.length > 1;
				const label = many ? `${name} · ${group.length} stories` : name;
				return (
					<a href={`/blog/${group[0].id}/`} data-posts={group.map((p) => p.id).join(' ')} aria-label={many ? `${label}: show them in the list` : `${group[0].data.title} (${name})`}>
						<title>{many ? `${label}\n${group.map((p) => p.data.title).join('\n')}` : `${name}: ${group[0].data.title}`}</title>
						<circle class="hit" cx={cx} cy={cy} r="22" />
						<circle class="ring" cx={cx} cy={cy} r="9" />
						<circle class="dot" cx={cx} cy={cy} r={many ? 13 : 9} />
						{many && <text class="count" x={cx} y={cy} dy="0.35em" text-anchor="middle">{group.length}</text>}
						<text class="name" x={cx} y={cy - 26} text-anchor="middle">{label}</text>
					</a>
				);
			})
		}
		</g>
	</svg>
	<!-- Space mode: the whole map (land and dots) wrapped on a spinning planet: two copies scroll inside a circle -->
	<svg class="globe" viewBox="0 0 500 500" aria-hidden="true">
		<defs>
			<clipPath id="globe-clip"><circle cx="250" cy="250" r="200" /></clipPath>
			<radialGradient id="globe-shade" cx="35%" cy="30%" r="75%">
				<stop offset="0" stop-color="#fff" stop-opacity="0.25" />
				<stop offset="0.45" stop-color="#fff" stop-opacity="0" />
				<stop offset="1" stop-color="#000" stop-opacity="0.65" />
			</radialGradient>
		</defs>
		<circle class="atmosphere" cx="250" cy="250" r="214" />
		<circle class="ocean" cx="250" cy="250" r="200" />
		<g clip-path="url(#globe-clip)">
			<g class="spin">
				<use href="#world" transform="translate(50 50) scale(0.8)" />
				<use href="#world" transform="translate(-750 50) scale(0.8)" />
			</g>
		</g>
		<circle cx="250" cy="250" r="200" fill="url(#globe-shade)" />
	</svg>
	<figcaption class="passport" hidden></figcaption>
</figure>
<button class="back" type="button" hidden>↑ Back to map</button>

<script>
	// Passport: pins with a story the reader finished get a stamp mark (see PassportStamp.astro)
	let book: Record<string, { place: string }> = {};
	try {
		book = JSON.parse(localStorage.getItem('wwh-passport') || '{}');
	} catch {}
	const read = Object.keys(book);
	const caption = document.querySelector<HTMLElement>('.passport')!;
	const reentry = (window as any).wwhReentry as number;
	if (reentry) {
		caption.textContent = `Re-entry complete: ${reentry} new ${reentry > 1 ? 'stories' : 'story'} on Earth`;
		caption.hidden = false;
	} else if (document.documentElement.dataset.world === 'space') {
		caption.textContent = 'All caught up. Welcome to Space Wide Hype';
		caption.hidden = false;
	}
	if (read.length) {
		document.querySelectorAll<SVGAElement>('svg a[data-posts]').forEach((pin) => {
			if (pin.dataset.posts!.split(' ').some((id) => book[id])) pin.classList.add('read');
		});
		const places = new Set(read.map((id) => book[id].place)).size;
		if (caption.hidden) caption.textContent = `Your passport: ${read.length} ${read.length > 1 ? 'stamps' : 'stamp'} from ${places} ${places > 1 ? 'places' : 'place'}`;
		caption.hidden = false;
	}

	// Hovering a post in the list lights up its pin on the map
	const pins = document.querySelectorAll<SVGAElement>('svg a[data-posts]');
	const has = (pin: SVGAElement, id?: string) => !!id && pin.dataset.posts!.split(' ').includes(id);
	let current: string | undefined;
	const light = (e: Event) => {
		const id = (e.target as Element).closest<HTMLElement>('li[data-post]')?.dataset.post;
		if (id === current) return;
		current = id;
		pins.forEach((pin) => {
			pin.classList.toggle('active', has(pin, id));
			if (has(pin, id)) pin.parentNode!.appendChild(pin); // draw on top of overlapping pins
		});
	};
	document.addEventListener('mouseover', light);
	document.addEventListener('focusin', light);

	// A dot with several stories scrolls to the list and marks them there instead of opening one
	const items = [...document.querySelectorAll<HTMLElement>('li[data-post]')];
	const backBtn = document.querySelector<HTMLButtonElement>('button.back')!;
	pins.forEach((pin) => {
		const ids = pin.dataset.posts!.split(' ');
		if (ids.length < 2) return;
		pin.addEventListener('click', (e) => {
			e.preventDefault();
			items.forEach((li) => li.classList.toggle('lit', ids.includes(li.dataset.post!)));
			items.find((li) => ids.includes(li.dataset.post!))?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			backBtn.hidden = false;
		});
	});
	// Clears the marks and returns to the map
	backBtn.addEventListener('click', () => {
		items.forEach((li) => li.classList.remove('lit'));
		backBtn.hidden = true;
		document.querySelector('figure')!.scrollIntoView({ behavior: 'smooth', block: 'center' });
	});

	// Globe: its dots are <use> copies, which can't be clicked one by one. Find the map pin under the
	// pointer through each copy's live (spinning) screen matrix, then hover/click the real pin instead.
	const globe = document.querySelector<SVGSVGElement>('svg.globe')!;
	const copies = [...globe.querySelectorAll<SVGUseElement>('use')];
	const pinAt = (e: MouseEvent) => {
		const box = globe.getBoundingClientRect();
		const unit = box.width / 500; // screen px per globe unit
		if (Math.hypot(e.clientX - box.left - box.width / 2, e.clientY - box.top - box.height / 2) > 200 * unit) return; // off the planet
		let best: SVGAElement | undefined;
		let bestD = Math.max(22 * 0.8 * unit, 16); // pin hit radius, at least a fingertip
		for (const use of copies) {
			const m = use.getScreenCTM()!;
			pins.forEach((pin) => {
				const dot = pin.querySelector('.dot')!;
				const p = new DOMPoint(+dot.getAttribute('cx')!, +dot.getAttribute('cy')!).matrixTransform(m);
				const d = Math.hypot(p.x - e.clientX, p.y - e.clientY);
				if (d < bestD) [best, bestD] = [pin, d];
			});
		}
		return best;
	};
	globe.addEventListener('mousemove', (e) => {
		const hit = pinAt(e);
		pins.forEach((pin) => pin.classList.toggle('active', pin === hit)); // the copies show the hover look
		globe.style.cursor = hit ? 'pointer' : '';
	});
	globe.addEventListener('mouseleave', () => pins.forEach((pin) => pin.classList.remove('active')));
	globe.addEventListener('click', (e) => pinAt(e)?.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })));
</script>

<style>
	figure {
		margin: 0 0 2em;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
	}
	.map {
		fill: rgb(var(--gray-light));
	}
	.globe,
	:global([data-world='space']) .map {
		display: none;
	}
	:global([data-world='space']) .globe {
		display: block;
		max-width: 420px;
		margin: 0 auto;
	}
	.ocean {
		fill: #13235a;
	}
	.atmosphere {
		fill: none;
		stroke: #6f9dff;
		stroke-width: 10;
		stroke-opacity: 0.35;
		filter: blur(6px);
	}
	.globe use {
		fill: var(--accent);
	}
	/* 800 units = one full turn of the scaled map; eastward, like the real Earth */
	.spin {
		animation: spin 60s linear infinite;
	}
	@keyframes spin {
		to { transform: translateX(800px); }
	}
	.hit {
		fill: transparent;
	}
	.dot {
		fill: var(--accent);
		stroke: var(--bg);
		stroke-width: 3;
	}
	.ring {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		transform-box: fill-box;
		transform-origin: center;
		animation: ping 2.4s ease-out infinite;
	}
	.dot,
	.name {
		transform-box: fill-box;
		transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.6, 1), opacity 0.3s;
	}
	.dot {
		transform-origin: center;
	}
	.count {
		fill: var(--bg);
		font-size: 16px;
		font-weight: 700;
		pointer-events: none;
	}
	.name {
		transform-origin: bottom;
		fill: rgb(var(--black));
		font-size: 30px;
		font-weight: 700;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
	}
	a:hover .dot,
	a:focus-visible .dot,
	.active .dot {
		fill: var(--accent-dark);
		transform: scale(1.6);
	}
	a:hover .name,
	a:focus-visible .name,
	.active .name {
		opacity: 1;
		transform: none;
	}
	.read .dot {
		fill: var(--stamp);
	}
	.read .ring {
		stroke: var(--stamp);
	}
	.passport {
		margin-top: 0.5em;
		color: var(--stamp);
		font-family: Helvetica, Arial, sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
	}
	.active .ring {
		animation-duration: 1s;
	}
	.back {
		position: fixed;
		bottom: 1.5em;
		left: 50%;
		z-index: 10;
		transform: translateX(-50%);
		padding: 0.6em 1.2em;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: var(--bg);
		font: inherit;
		font-weight: 700;
		box-shadow: var(--box-shadow);
		cursor: pointer;
	}
	.back[hidden] {
		display: none;
	}
	@keyframes ping {
		from { transform: scale(1); opacity: 0.9; }
		to { transform: scale(3); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ring { animation: none; opacity: 0; }
		.spin { animation: none; }
	}
</style>
