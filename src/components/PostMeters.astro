---
import { langOf, t } from '../i18n';

// Indicators shown under a post's title. Scoring rules live in AGENTS.md (Auto-posting rules).
interface Props {
	hype?: { attention: number; impact: number };
	sources: number;
}

const { hype, sources } = Astro.props;
const ui = t(langOf(Astro.url));
const bars = [
	hype && { label: ui.attention, value: hype.attention, max: 10, title: ui.attentionTitle },
	hype && { label: ui.impact, value: hype.impact, max: 10, title: ui.impactTitle },
	sources > 0 && { label: ui.verified, value: Math.min(sources, 5), max: 5, text: ui.sources(sources), title: ui.verifiedTitle },
].filter((b) => !!b);
---

{bars.length > 0 && (
	<section class="meters" aria-label={ui.indicators}>
		{bars.map((b) => (
			<div class="row" title={b.title}>
				<span class="label">{b.label}</span>
				<span class="track" role="meter" aria-valuemin="0" aria-valuemax={b.max} aria-valuenow={b.value} aria-label={b.label}>
					<span class="fill" style={`width:${(b.value / b.max) * 100}%`}></span>
				</span>
				<span class="value">{b.text ?? `${b.value}/${b.max}`}</span>
			</div>
		))}
	</section>
)}

<style>
	.meters {
		display: grid;
		gap: 0.6em;
		margin: 0 0 2em;
		padding: 1em 1.2em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		font-size: 0.9em;
	}
	.row {
		display: grid;
		grid-template-columns: 5.5em 1fr 5.5em;
		align-items: center;
		gap: 0.8em;
	}
	.label {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.value {
		color: rgb(var(--gray));
		text-align: right;
		white-space: nowrap;
	}
	.track {
		height: 10px;
		border-radius: 5px;
		background: rgb(var(--gray-light));
		overflow: hidden;
	}
	.fill {
		display: block;
		height: 100%;
		border-radius: 5px;
		background: var(--accent);
	}
	@media (max-width: 480px) {
		.row {
			grid-template-columns: 4.8em 1fr 4.8em;
			gap: 0.5em;
		}
	}
</style>
