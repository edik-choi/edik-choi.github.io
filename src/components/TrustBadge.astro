---
// Shown above a post title when isTrusted() in src/posts.ts passes
interface Props {
	large?: boolean;
}
const { large = false } = Astro.props;
---

<span class:list={["badge", { large }]} title="Cross-checked against 3+ sources and covered by 6+ news outlets">
	<svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
	Well-sourced
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		margin-bottom: 0.4em;
		padding: 0.2em 0.6em;
		border-radius: 999px;
		background: var(--accent);
		color: var(--bg);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.4;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
	.large {
		margin-bottom: 0.8em;
		padding: 0.35em 1em;
		font-size: 1.1rem;
	}
</style>
