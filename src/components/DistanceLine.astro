---
// Pin icon + "8,100 km from Seoul" under the post title: how far the story is from the reader. Where the reader is comes from their device's time zone,
// so no permission prompt and nothing leaves the browser.
interface Props {
	place: { name: string; lat: number; lon: number };
}

const { place } = Astro.props;
---

<div class="distance" data-name={place.name} data-lat={place.lat} data-lon={place.lon} hidden>
	<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
	<span></span>
</div>

<script>
	// Time zone → coordinates of its main city, generated from /usr/share/zoneinfo/zone.tab
	// ponytail: time-zone accuracy (a whole zone maps to one city); switch to geolocation if exact distance matters
	import zones from '../assets/tz-coords.json';

	const el = document.querySelector<HTMLElement>('.distance');
	const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
	const me = (zones as Record<string, number[]>)[tz];
	// "America/Argentina/Buenos_Aires" → "Buenos Aires"
	const city = tz.split('/').pop()!.replace(/_/g, ' ');
	const ko = document.documentElement.lang === 'ko';
	let km = 0;
	if (el && me) {
		const r = Math.PI / 180;
		const [a, b] = me, c = +el.dataset.lat!, d = +el.dataset.lon!;
		const h = Math.sin(((c - a) * r) / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(((d - b) * r) / 2) ** 2;
		km = Math.round((2 * 6371 * Math.asin(Math.sqrt(h))) / 100) * 100;
		const text = km < 100 ? '< 100 km' : `${km.toLocaleString('en')} km`;
		el.querySelector('span')!.textContent = ko ? `${city}에서 ${text}` : `${text} from ${city}`;
		el.title = ko ? `${el.dataset.name}은(는) ${city}(내 시간대)에서 약 ${text}` : `${el.dataset.name} is about ${text} from ${city} (your time zone)`;
		el.hidden = false;
	}
	// Space mode: the reader is out in space, a few hundred thousand km from the story and drifting further every second
	if (el && document.documentElement.dataset.world === 'space') {
		let far = 300000 + (km || Math.random() * 20000) * 10 + Math.random() * 1000;
		// Pin moves into the text so it sits inline on the first line, not beside both lines
		const text = document.createTextNode('');
		el.querySelector('span')!.replaceChildren(el.querySelector('svg')!, text);
		const tick = () => {
			const dist = `${Math.round(far).toLocaleString('en')} km`;
			text.data = ko ? ` ${el.dataset.name}까지\n${dist}` : ` ${dist} from\n${el.dataset.name}`;
			far += 20 + Math.random() * 40;
			setTimeout(tick, 1000);
		};
		tick();
		el.title = ko ? `우주선과 ${el.dataset.name} 사이의 거리` : `How far your ship is from ${el.dataset.name}`;
		el.hidden = false;
	}
</script>

<style>
	.distance {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.25em;
		margin: -0.2em 0 1em;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	/* Space mode: "~km from" over the city name */
	.distance span {
		white-space: pre-line;
		text-align: center;
	}
	.distance span svg {
		vertical-align: -0.125em;
	}
	.distance[hidden] {
		display: none;
	}
</style>
