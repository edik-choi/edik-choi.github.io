---
// Reaching the end of a post stamps it into the reader's "passport" (localStorage); the home map shows the stamps
interface Props {
	place: string;
}

const { place } = Astro.props;
---

<div class="stamp" data-place={place} aria-live="polite">
	<span class="top">World Wide Hype</span>
	<strong>READ</strong>
	<span class="place">{place}</span>
	<span class="date"></span>
</div>

<script>
	const KEY = 'wwh-passport';
	const stamp = document.querySelector<HTMLElement>('.stamp')!;
	const id = location.pathname.split('/').filter(Boolean).pop()!;
	let book: Record<string, { place: string; date: string }> = {};
	try {
		book = JSON.parse(localStorage.getItem(KEY) || '{}');
	} catch {}
	const show = (date: string) => (stamp.querySelector('.date')!.textContent = date);

	// Lift-off: the page shakes, sinks away under a rocket glow, the world flips to space while the
	// screen is empty (stars burst past, Warp.astro), then the page settles back in
	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const launch = async () => {
		const w = window as any;
		if (matchMedia('(prefers-reduced-motion: reduce)').matches) return w.wwhWorld();
		await wait(700); // let the stamp land first
		const parts = [...document.querySelectorAll<HTMLElement>('body > header, body > main, body > footer')];
		const glow = document.createElement('div');
		glow.style.cssText = 'position:fixed;inset:0;z-index:20;pointer-events:none;background:linear-gradient(to top,rgba(255,166,43,.85),rgba(255,241,184,.35) 35%,transparent 70%)';
		document.body.append(glow);
		glow.animate([{ opacity: 0 }, { opacity: 1, offset: 0.4 }, { opacity: 0 }], { duration: 2000 }).finished.then(() => glow.remove());
		const jiggle = [{ transform: 'none' }, { transform: 'translate(-3px, 2px)' }, { transform: 'translate(3px, -2px)' }, { transform: 'none' }];
		await Promise.all(parts.map((el) => el.animate(jiggle, { duration: 110, iterations: 6 }).finished));
		const sink = parts.map((el) =>
			el.animate([{ transform: 'none', opacity: 1 }, { transform: 'translateY(110vh)', opacity: 0 }], { duration: 1100, easing: 'cubic-bezier(.5,0,.9,.4)', fill: 'forwards' }),
		);
		await sink[0].finished;
		w.wwhWorld();
		dispatchEvent(new Event('wwh-launch'));
		await wait(1300);
		sink.forEach((a) => a.cancel());
		parts.forEach((el) => el.animate([{ transform: 'translateY(-60px)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 900, easing: 'ease-out' }));
	};

	if (book[id]) {
		show(book[id].date);
		stamp.classList.add('done');
	} else {
		new IntersectionObserver(([entry], obs) => {
			if (!entry.isIntersecting) return;
			obs.disconnect();
			const date = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
			book[id] = { place: stamp.dataset.place!, date };
			try {
				localStorage.setItem(KEY, JSON.stringify(book));
			} catch {}
			show(date);
			stamp.classList.add('done', 'thud');
			const w = window as any;
			// The last unread map story launches the reader into space
			if (document.documentElement.dataset.world !== 'space' && w.wwhAllRead()) launch();
			else w.wwhWorld();
		}, { threshold: 0.9 }).observe(stamp); // not 1: sub-pixel sizes can leave the ratio at 0.99999 forever
	}
</script>

<style>
	.stamp {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: fit-content;
		min-width: 9em;
		margin: 3em auto 1em;
		padding: 0.6em 1.4em;
		border: 4px double var(--stamp);
		border-radius: 14px;
		color: var(--stamp);
		font-family: Helvetica, Arial, sans-serif;
		text-transform: uppercase;
		line-height: 1.2;
		opacity: 0;
		transform: rotate(-8deg);
	}
	.stamp.done {
		opacity: 0.85;
	}
	.thud {
		animation: thud 0.45s cubic-bezier(0.3, 1.4, 0.6, 1);
	}
	.top,
	.date {
		font-size: 0.7rem;
		letter-spacing: 0.15em;
	}
	strong {
		font-size: 2.2rem;
		letter-spacing: 0.2em;
	}
	.place {
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	@keyframes thud {
		from { opacity: 0; transform: rotate(-20deg) scale(2.4); }
		to { opacity: 0.85; transform: rotate(-8deg) scale(1); }
	}
	@media (prefers-reduced-motion: reduce) {
		.thud { animation: none; }
	}
</style>
