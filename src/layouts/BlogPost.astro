---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PostMeters from '../components/PostMeters.astro';
import DistanceLine from '../components/DistanceLine.astro';
import TrustBadge from '../components/TrustBadge.astro';
import WeatherBackdrop from '../components/WeatherBackdrop.astro';
import PassportStamp from '../components/PassportStamp.astro';
import PostList from '../components/PostList.astro';
import { langOf, t } from '../i18n';
import type { Post } from '../posts';

// pubDate is optional so pages like About can use this layout without a date
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate'> & { pubDate?: Date; sources?: number; trusted?: boolean; ogImage?: string; newer?: Post; older?: Post; translated?: boolean };

const { title, description, pubDate, updatedDate, heroImage, category, hype, location: place, sources = 0, trusted = false, ogImage, newer, older, translated } = Astro.props;
const lang = langOf(Astro.url);
const ui = t(lang);
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={ogImage} imageAlt={ogImage && `${ui.infographic}: ${title}`} published={pubDate} translated={translated} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.more {
				margin: 1.5em 0 0.2em;
				font-size: 1em;
				color: rgb(var(--gray));
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				/* Full width of main on phones: main and prose padding give the side inset */
				max-width: 100%;
				box-sizing: border-box;
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			/* Reading progress: scroll-driven, no JS. Browsers without support just don't show it. */
			.progress {
				display: none;
			}
			@supports (animation-timeline: scroll()) {
				.progress {
					display: block;
					position: fixed;
					top: 0;
					left: 0;
					z-index: 11;
					width: 100%;
					height: 4px;
					background: var(--accent);
					transform-origin: left;
					/* Longhands only: the minifier folds a shorthand + timeline into one invalid shorthand */
					animation-name: read;
					animation-timing-function: linear;
					animation-fill-mode: both;
					animation-timeline: scroll(root);
				}
			}
			.share {
				margin-bottom: 1em;
				padding: 0.4em 1.1em;
				border: 1px solid var(--accent);
				border-radius: 999px;
				background: transparent;
				color: var(--accent);
				font: inherit;
				font-size: 0.9rem;
				cursor: pointer;
			}
			.share:hover {
				background: var(--accent);
				color: var(--bg);
			}
			@keyframes read {
				from { transform: scaleX(0); }
				to { transform: scaleX(1); }
			}
		</style>
	</head>

	<body>
		<div class="progress" aria-hidden="true"></div>
		<WeatherBackdrop />
		<Header translated={translated} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{updatedDate && (
								<div class="last-updated-on">
									{ui.lastUpdated} <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						{trusted && <TrustBadge large />}
						<h1>{title}</h1>
						{place && <DistanceLine place={place} />}
						{category && <button type="button" class="share" data-title={title} data-copied={ui.copied}>{ui.share}</button>}
						<hr />
					</div>
					<PostMeters hype={hype} sources={sources} />
					<slot />
					{place && <PassportStamp place={place.name} />}
					{newer && (<><h2 class="more">{ui.next}</h2><PostList posts={[newer]} /></>)}
					{older && (<><h2 class="more">{ui.previous}</h2><PostList posts={[older]} /></>)}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			// Phones get the native share sheet; desktops copy the link
			const btn = document.querySelector<HTMLButtonElement>('.share');
			btn?.addEventListener('click', async () => {
				const url = location.href;
				if (navigator.share) {
					try {
						await navigator.share({ title: btn!.dataset.title, url });
					} catch {} // cancelled
					return;
				}
				await navigator.clipboard.writeText(url);
				const label = btn!.textContent;
				btn!.textContent = btn!.dataset.copied!;
				setTimeout(() => (btn!.textContent = label), 2000);
			});
		</script>
	</body>
</html>
